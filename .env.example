# Shopify app credentials:
# - SHOPIFY_API_KEY is the app API key / client ID
# - SHOPIFY_API_SECRET is the app secret and must stay private
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_SCOPES=read_products,write_products

# PUBLIC APP URL for your deployed app. Shopify must be able to call it.
HOST=https://your-public-app-url.example

# Upstash Redis credentials for token storage in production.
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Use a long random secret for session encryption. Do not commit this.
# SESSION_SECRET should be at least 32 characters.
SESSION_SECRET=a_long_random_secret
